# Copy this file to .env and fill it in. .env is ignored by git and docker.

# --- Folders and user ---------------------------------------------------------
# Where your music lives. Playlists are written to AppleMusic/ and SpotifyMusic/ inside it.
MUSIC_DIR=./music
# The user and group that own your music folder (run `id` to see yours).
PUID=1000
PGID=1000
TZ=UTC

# --- Soulseek (required) ------------------------------------------------------
# Any username and password: the account is created the first time slskd logs in.
SOULSEEK_USERNAME=
SOULSEEK_PASSWORD=
# Password for slskd's own web UI at http://localhost:5030.
SLSKD_WEB_PASSWORD=
# A random string of 16 or more characters that lets the app talk to slskd.
# Generate one with: openssl rand -hex 32
SLSKD_API_KEY=

# --- Apple Music (optional) ---------------------------------------------------
# Without an Apple Developer account: leave these empty and connect on the app's
# "Connect Apple Music" page by pasting a cookie from music.apple.com.
# With an Apple Developer account: put your MusicKit key in secrets/AuthKey.p8 and fill these in.
APPLE_TEAM_ID=
APPLE_KEY_ID=

# --- Spotify (optional) -------------------------------------------------------
# Client ID of your app at developer.spotify.com/dashboard. You can also enter it on the Settings page.
SPOTIFY_CLIENT_ID=

# --- Other --------------------------------------------------------------------
# 1 to download songs from YouTube when Soulseek doesn't have them. Also a switch on the Settings page.
YOUTUBE_FALLBACK=0
# Set a password if anyone else on your network can reach port 8080.
APP_PASSWORD=
# Genius API client access token (optional). Adds Genius page views to hits playlists.
# Make one at https://genius.com/api-clients
GENIUS_API_TOKEN=
# ListenBrainz user token (optional), for each artist's listener counts in hits playlists.
# It's on https://listenbrainz.org/settings/ after you sign in.
LISTENBRAINZ_TOKEN=

# --- VPN (only with docker-compose.vpn.yml) -------------------------------------
# Defaults are for Private Internet Access. Regions with port forwarding work best.
VPN_SERVICE_PROVIDER=private internet access
VPN_USER=
VPN_PASSWORD=
VPN_REGIONS=CA Montreal
